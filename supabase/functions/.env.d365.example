# Template for the Dynamics 365 Finance and Operations connector (erp_sync edge function).
#
# DO NOT put real values in this file or in any file of the repository.
# Set them as Supabase secrets, only once DDC has approved the integration and
# an authorized SANDBOX environment is available:
#
#   npx supabase secrets set D365_TENANT_ID=... D365_CLIENT_ID=... D365_CLIENT_SECRET=...
#
# The web application never receives these values. The connector is also
# refused by the database unless erp_connector_config.approval_status = 'approved'.

# Microsoft Entra ID tenant of the F&O environment
D365_TENANT_ID=
# App registration (client credentials flow), least privilege, see docs/ddc/ERP-INTEGRATION.md
D365_CLIENT_ID=
D365_CLIENT_SECRET=
# Name of the modification timestamp field exposed by the enabled data entities (unverified).
# Leave empty to disable incremental filtering (full reads only).
D365_MODIFIED_FIELD=
